# Copy to an operator-local env file before joining a public testnet.
# Do not commit private keys or operator-specific secrets.

# API/indexer database.
DATABASE_URL=postgresql://pc:pc@localhost:5432/popular_consensus

# Content-addressed artifact storage for public testnet records.
ARTIFACT_DIR=./data/public-testnet-artifacts

# Public testnet operators should run outside local dev/demo mode.
PC_DEV_MODE=false
PC_DEMO_MODE=false

# API listener. Set HOST=0.0.0.0 only when the operator intends to expose the API.
HOST=127.0.0.1
PORT=4000

# Web app API target for operator-hosted frontends.
NEXT_PUBLIC_API_URL=https://operator-api.example.org

# Contract/appchain deployment target.
RPC_URL=https://public-testnet-rpc.example.org
DEPLOYER_PRIVATE_KEY=

# Attestation collection inputs.
PUBLIC_TESTNET_OPERATOR_ID=operator-name-or-public-key
PUBLIC_TESTNET_OPERATOR_ROLE=replay-verifier
PUBLIC_TESTNET_CHAIN_ID=pc-public-testnet
PUBLIC_TESTNET_COMMUNITY_ID=community-vancouver
PUBLIC_TESTNET_API_BASE_URL=https://operator-api.example.org
